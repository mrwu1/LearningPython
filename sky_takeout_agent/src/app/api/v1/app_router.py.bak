@api_router.get("/healthz",summary="health check")
def check_health()->dict:
    logger.info("正在执行健康检查探针逻辑...")
    return {
        "status": "ok",
        "app_name": settings.APP_NAME,
        "env": settings.ENV_MODE,
        "db_target": f"{settings.DB_USER}@{settings.DB_HOST}:{settings.DB_PORT}/{settings.DB_NAME}",
        # 注意：SecretStr 取出真实密钥必须调 .get_secret_value()
        "key_masked": f"{settings.OPENAI_API_KEY.get_secret_value()[:6]}******"
    }
@api_router.get("/health_redis",summary="redis health check")
async def check_redis_connections()->bool:
    """health check: test the connection status for redis"""
    try:
        await redis_client.ping()
        logger.info("✅ Redis 异步连接池就绪！")
        return True
    except Exception as e:
        logger.error(f"❌ Redis 连接失败: {e}")
        return False

@api_router.get("/dishes", summary="异步查询真实外卖菜品列表")
async def list_dishes():
    logger.info(f"ready to start deal with the request")
    async with AsyncSessionLocal() as session:
        stmt = select(Dish).limit(5)
        logger.info(f"SQL is ready:{stmt}")
        result = await session.execute(stmt)
        logger.info(f"execute sql successful: {result}")
        dishes = result.scalars().all()
        return {
            "total": len(dishes),
            "data": [
                {"id": d.id, "name": d.name, "price": float(d.price), "status": d.status}
                for d in dishes
            ]
        }
@api_router.get("/dishes_dep", summary="dep-异步查询真实外卖菜品列表")
async def list_dishes_dep(session:SessionDep):
    stmt = select(Dish).limit(5)
    result = await session.execute(stmt)
    logger.info(f"stmt sql:{stmt},execute sql successful: {result}")
    dishes = result.scalars().all()
    return {
        "total": len(dishes),
        "data": [
            {"id": d.id, "name": d.name, "price": float(d.price), "status": d.status}
            for d in dishes
        ]
    }

@api_router.get("/dishes_redis", summary="redis异步查询真实外卖菜品列表")
async def list_dishes_with_cache(session:SessionDep):
    cache_key = "sky:takeout:dishes:top5"

    cached_data = await redis_client.get(cache_key)
    logger.info(f"the result for redis:{cached_data}")
    if  not cached_data:
        stmt = select(Dish).limit(5)
        result = await session.execute(stmt)
        logger.info(f"sq:{stmt},\n execute sql successful: {result}")
        dishes = result.scalars().all()
        query = {
            "total": len(dishes),
            "data": [
                {"id": d.id, "name": d.name, "price": float(d.price), "status": d.status}
                for d in dishes
            ]
        }
        await redis_client.set(cache_key, json.dumps(query), ex=60)
        logger.info(f"the sql result has been write into redis.")
        return query
    logger.info(f"return redis query result directly!{cached_data}")
    return  json.loads(cached_data)


@api_router.post("/orders/submit")
async def submitOrder(order_id:int):
    #mock the high concurrency
    lock_key = f"lock:order:{order_id}"

    # 获取 redis 异步锁实例：超时 10 秒自动释放防止死锁，非阻塞尝试获取
    # blocking=False 等同于 Java 的 tryLock(0, TimeUnit.SECONDS)
    lock = redis_client.lock(lock_key,timeout=10,blocking=False)

    # 1. add a lock
    acquired = await lock.acquire()
    if not acquired:
        logger.warning(f"⚠️：the {order_id} is dealing to db,trigger the repeat warning")
        raise HTTPException(status_code=409, detail="service busy! please try again later")

    try:
        logger.info(f"start a new order_id{order_id}")
        await asyncio.sleep(3)
        logger.info("successful work!")
        return {"code": 200, "message": f"order {order_id} submit success"}
    finally:
        await lock.release()
        logger.info("the lock has been released successful!")

class LoginRequest(BaseModel):
    username:str
    password:str
@api_router.post("/login")
async def login(req:LoginRequest):
    # 模拟外卖平台两类用户验证：管理员与普通骑手
    if req.username == "admin" and req.password == "admin123":
        user_role = "ADMIN"
    elif req.username == "rider" and req.password == "rider123":
        user_role = "RIDER"
    else:
        raise HTTPException(status_code=400, detail="用户名或密码错误")

    token = create_access_token({"sub": req.username,"username": req.username,  "role": user_role})
    return {"access_token": token, "token_type": "bearer", "role": user_role}


