async def admin_create_dish(admin_user: Annotated[dict, Depends(check_role("ADMIN"))]):
    return {"message": "操作成功：管理员已完成菜品配置", "operator": admin_user["username"]}

#-----------fastapi 参数的自动解析功能 ✅✅✅-------------------
@api_router.get("/favorites/{category_id}")
async def get_favorites(
        category_id: int,  # 1. 路径参数 (Path Param): 匹配 URL 中的 {category_id}
        page: int = 1,  # 2. 查询参数 (Query Param): ?page=1
        page_size: int = 10,  # 2. 查询参数 (Query Param): &page_size=10
        keyword: str | None = None,  # 2. 查询参数 (可选): &keyword=xxx
        user: UserDep = None,  # 3. 依赖注入：自动解析 JWT 得到当前登录用户
        session: SessionDep = None  # 4. 依赖注入：自动借出 DB 连接，并在方法结束后自动 Commit
):
    # 此时，所有数据全都在局部变量里就绪了！
    print(f"当前操作用户: {user['username']}")
    print(f"查询目标分类: {category_id}, 页码: {page}, 关键词: {keyword}")

    # 直接用 session 查数据库
    # stmt = select(Favorite).where(Favorite.user_id == user["user_id"])
    # result = await session.execute(stmt)

    return {"status": "ok", "operator": user["username"]}

