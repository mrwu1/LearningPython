---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	drafter(drafter)
	risk_audit(risk_audit)
	archiver(archiver)
	__end__([<p>__end__</p>]):::last
	__start__ --> drafter;
	drafter --> risk_audit;
	risk_audit -.-> __end__;
	risk_audit -.-> archiver;
	archiver --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
