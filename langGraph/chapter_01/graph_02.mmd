---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	dispatch(dispatch)
	inventory(inventory)
	rider(rider)
	coupon(coupon)
	summary(summary)
	__end__([<p>__end__</p>]):::last
	__start__ --> dispatch;
	coupon --> summary;
	dispatch --> coupon;
	dispatch --> inventory;
	dispatch --> rider;
	inventory --> summary;
	rider --> summary;
	summary --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
