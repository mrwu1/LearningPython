---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	propose(propose)
	execute(execute<hr/><small><em>__interrupt = before</em></small>)
	propose_a(propose_a)
	execute_b(execute_b<hr/><small><em>__interrupt = before</em></small>)
	__end__([<p>__end__</p>]):::last
	__start__ --> propose;
	__start__ --> propose_a;
	propose --> execute;
	propose_a --> execute_b;
	execute --> __end__;
	execute_b --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
